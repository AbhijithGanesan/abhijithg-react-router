		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && tsc -b"
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261019.1": true,
		"workerd@1.20261023.1": true
	}
